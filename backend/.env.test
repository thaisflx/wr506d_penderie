# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Conteneur PostgreSQL ; Doctrine ajoute le suffixe "_test" (config/packages/doctrine.yaml) → penderie_db_test
DATABASE_URL="postgresql://penderie_user:penderie_password@db:5432/penderie_db?serverVersion=16&charset=utf8"
# Scan IA désactivé par défaut en test (les tests injectent un scanner simulé)
OPENROUTER_API_KEY=
